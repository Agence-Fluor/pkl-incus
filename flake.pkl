#!/usr/bin/env -S pkl eval
amends "@nix/Flake.pkl"

import "@nix/Nix.pkl" as Nix

description = "Toolchain for generating and packaging Incus Pkl specifications"

inputs {
  ["nixpkgs"] = new Nix.Input { url = "github:NixOS/nixpkgs/nixos-unstable" }
}

local systems = List("x86_64-linux", "aarch64-linux", "x86_64-darwin", "aarch64-darwin")

devShells {
  for (system in systems) {
    [system] {
      ["default"] = new Nix.Raw {
        code =
          """
          let
            pkgs = inputs.nixpkgs.legacyPackages.\(system);
            python = pkgs.python3.withPackages (packages: [ packages.pyyaml ]);
          in
          pkgs.mkShell {
            packages = [ pkgs.pkl python pkgs.curl pkgs.unzip ];
          }
          """
      }
    }
  }
}
